	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"env:setup": "node scripts/setup-env.mjs",
		"lex:generate": "lex-cli generate",
