		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@types/node": "^24.10.9",
		"drizzle-kit": "^0.31.8",
		"drizzle-orm": "^0.45.1",
		"prettier": "^3.8.1",
		"prettier-plugin-css-order": "^2.2.0",
		"prettier-plugin-svelte": "^3.4.1",
		"svelte": "^5.49.1",
